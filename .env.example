# ========================================================
# Remove BG - Coolify & Docker Environment Variables
# ========================================================

# Frontend Public API URL (Domain or Subdomain where your API is hosted)
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# AI Virtual Try-On API Keys (Optional)
REPLICATE_API_TOKEN=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Super Admin Credentials
SUPERADMIN_EMAIL=admin@removebg.local
SUPERADMIN_PASSWORD=superadmin123
SUPERADMIN_SECRET=superadmin123

# Database (PostgreSQL)
POSTGRES_DB=removebg
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_secret_password_in_prod

# Port Mappings (if needed)
PORT=4000

