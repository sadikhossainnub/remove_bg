# ─── rembg AI Microservice Dockerfile (with pre-baked Model) ───
FROM python:3.10-slim

ENV PYTHONUNBUFFERED=1 \
    HOST=0.0.0.0 \
    PORT=5000 \
    REMBG_MODEL=isnet-general-use \
    U2NET_HOME=/root/.u2net

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Install rembg with CPU onnxruntime
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir "rembg[cpu]>=2.0.50"

# Pre-download and bake the AI model directly inside the Docker image
RUN mkdir -p /root/.rembg/models/isnet-general-use /root/.u2net && \
    echo "Downloading isnet-general-use AI model (~176MB)..." && \
    curl -fL "https://github.com/danielgatis/rembg/releases/download/v0.0.0/isnet-general-use.onnx" \
      -o /root/.rembg/models/isnet-general-use/isnet-general-use.onnx && \
    cp /root/.rembg/models/isnet-general-use/isnet-general-use.onnx /root/.u2net/isnet-general-use.onnx && \
    python3 -c "from rembg import new_session; new_session('isnet-general-use'); print('✅ Model verified and baked into image!')"

# Copy the server script
COPY src/services/rembg_server.py /app/rembg_server.py

EXPOSE 5000

CMD ["python3", "rembg_server.py"]

